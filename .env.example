# Copy this file to .env and fill in your project values.
# Vite only exposes variables prefixed with VITE_

# Server settings
PORT=5176


BREVO_API_KEY=your_brevo_api_key_here
SMTP_FROM=your_verified_email@gmail.com
SMTP_FROM_NAME=CINEVERSE

# Firebase Admin service account (choose one method)
# Method 1: File path (for local development)
GOOGLE_APPLICATION_CREDENTIALS=server/serviceAccountKey.json
# Method 2: JSON string (for production/Render - paste entire JSON as single line)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# TMDB API Key - Get from https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Firebase Configuration - Get from Firebase Console
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloudinary Configuration (for image uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Games APIs
RAWG_API_KEY=your_rawg_api_key_here
GAMEBRAIN_API_KEY=your_gamebrain_api_key_here