# Copy this file to .env and fill in your project values.
# Vite only exposes variables prefixed with VITE_

# Server settings
PORT=5176

# SMTP Configuration for OTP emails (SendGrid - works perfectly on Render)
# 1. Sign up: https://signup.sendgrid.com/
# 2. Settings → API Keys → Create API Key
# 3. Sender Authentication → Verify Single Sender
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_API_KEY
SMTP_FROM=your_verified_email@gmail.com

# Firebase Admin service account
GOOGLE_APPLICATION_CREDENTIALS=server/serviceAccountKey.json

# TMDB API Key - Get from https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=2f0c4d355398a7cb7b60f0ffdb48222e

# Firebase Configuration
VITE_FIREBASE_API_KEY=AIzaSyBFT6aV_BtaIU_AyhfK2jqk4J-tpgkjIp4
VITE_FIREBASE_AUTH_DOMAIN=cineverse-33de1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cineverse-33de1
VITE_FIREBASE_STORAGE_BUCKET=cineverse-33de1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1009313224347
VITE_FIREBASE_APP_ID=1:1009313224347:web:a60a87a149dc4bda81583e
VITE_FIREBASE_MEASUREMENT_ID=G-SXFTDK1Y1L

# Cloudinary Configuration (for image uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here